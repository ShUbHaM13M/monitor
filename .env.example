DATABASE_URL=postgres://monitor:monitor@localhost:5432/monitor
BIND_ADDR=0.0.0.0:3000
# Public base URL used when rendering ping URLs and links in alerts.
BASE_URL=http://localhost:3000
DB_MAX_CONNECTIONS=10
# Apply pending migrations at startup (handy in dev; use `monitor migrate` in prod).
AUTO_MIGRATE=true
SMTP_URL=smtp://localhost:1025
SMTP_FROM="Monitor <alerts@localhost>"
# 32 random bytes, base64. Generate with: cargo run -- gen-key
SECRET_KEY=
# Lets webhook channels reach localhost/private IPs. Dev only: never enable in production.
ALLOW_PRIVATE_TARGETS=true
RUST_LOG=monitor=debug,tower_http=info,sqlx=warn
# Set to "json" for structured logs in production.
LOG_FORMAT=pretty
