# Copy to deploy/.env and fill in. Read by docker compose and passed to the app.

# Public hostname; Caddy gets a certificate for it and BASE_URL becomes https://$DOMAIN.
DOMAIN=monitor.example.com

# Use letters and digits only: it's embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# 32 random bytes, base64. Generate with: docker run --rm monitor:latest gen-key
# Keep a backup: losing it makes stored channel settings and webhook secrets unreadable.
SECRET_KEY=

# Email alerts, confirmation and password-reset links. Without it, only webhook channels.
SMTP_URL=smtps://user:password@smtp.example.com
SMTP_FROM=Monitor <alerts@example.com>

# Plan limits for every org (override one org with UPDATE orgs SET max_checks = …).
PLAN_MAX_CHECKS=100
PLAN_MAX_MONITORS=20
PLAN_MAX_CHANNELS=10
PLAN_MAX_STATUS_PAGES=3
PLAN_MIN_INTERVAL_SECS=30

RUST_LOG=monitor=info,tower_http=warn,sqlx=warn
