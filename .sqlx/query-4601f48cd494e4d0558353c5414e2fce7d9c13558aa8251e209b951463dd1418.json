{
  "db_name": "PostgreSQL",
  "query": "SELECT n.event, COALESCE(n.payload->'source'->>'name', n.payload->>'check_name') AS source_name, n.status, n.attempts,\n                  n.last_error, n.created_at, n.sent_at\n           FROM notifications n\n           JOIN channels ch ON ch.id = n.channel_id\n           WHERE n.channel_id = $1 AND ch.org_id = $2\n           ORDER BY n.created_at DESC\n           LIMIT $3",
