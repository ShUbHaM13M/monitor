  "db_name": "PostgreSQL",
  "query": "SELECT u.id AS user_id, u.password_hash, m.org_id AS \"org_id?\"\n           FROM users u\n           LEFT JOIN LATERAL (\n               SELECT org_id FROM memberships\n               WHERE user_id = u.id\n               ORDER BY created_at\n               LIMIT 1\n           ) m ON true\n           WHERE lower(u.email) = lower($1)",
