  "query": "SELECT r.ok, r.status_code, r.latency_ms, r.error, r.created_at\n         FROM http_results r JOIN http_monitors m ON m.id = r.monitor_id\n         WHERE r.monitor_id = $1 AND m.org_id = $2\n         ORDER BY r.created_at DESC, r.id DESC\n         LIMIT $3",
