{
  "db_name": "PostgreSQL",
  "query": "SELECT ch.id, ch.kind, ch.config_enc, o.name AS org_name\n         FROM channels ch JOIN orgs o ON o.id = ch.org_id\n         WHERE ch.verify_token_hash = $1 AND ch.verified_at IS NULL\n           AND ch.verify_sent_at > now() - make_interval(days => $2)",
